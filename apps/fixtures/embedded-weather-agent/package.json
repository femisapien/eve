{
  "name": "embedded-weather-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "EVE_INTERNAL_AGENT_SELECTION='{\"entry\":\"weather-agent.ts\",\"registration\":\"weather\"}' eve dev",
