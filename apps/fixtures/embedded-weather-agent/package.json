    "start": "EVE_INTERNAL_AGENT_SELECTION='{\"entry\":\"weather-agent.ts\",\"registration\":\"weather\"}' eve start",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "eve": "workspace:*",
    "zod": "catalog:"
  }
}
